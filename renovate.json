{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "compose.yaml's Go, which the shell default hides from the docker-compose manager",
      "managerFilePatterns": [
        "/^compose\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>golang):\\$\\{GO_VERSION:-(?<currentValue>[^}]+)\\}"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "goreleaser/goreleaser",
      "description": "GoReleaser in the Packages workflow; keep it equal to the goreleaser image the gate checks the config with",
      "managerFilePatterns": [
        "/^\\.github/workflows/packages\\.yml$/"
      ],
      "matchStrings": [
        "goreleaser/goreleaser-action@\\S+\\s+with:\\s+version: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "go",
      "description": "Go tools the Dockerfile and compose.yaml run with go run, by their module path",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^compose\\.yaml$/"
      ],
      "matchStrings": [
        "go run (?<depName>[^@\\s]+?)(/cmd/[^@\\s]+)?@(?<currentValue>v\\S+)"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "groupName": "GoReleaser",
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ]
    },
    {
      "description": "A Go patch merges itself once every check passes; CI then releases it as a patch of the last release",
      "matchPackageNames": [
        "golang"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
