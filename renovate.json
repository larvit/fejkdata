{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "compose.yaml's Go, which the shell default hides from the docker-compose manager",
      "managerFilePatterns": [
        "/^compose\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>golang):\\$\\{GO_VERSION:-(?<currentValue>[^}]+)\\}"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "goreleaser/goreleaser",
      "description": "GoReleaser in the Packages workflow; keep it equal to the goreleaser image the gate checks the config with",
      "managerFilePatterns": [
        "/^\\.github/workflows/packages\\.yml$/"
      ],
      "matchStrings": [
        "goreleaser/goreleaser-action@\\S+\\s+with:\\s+version: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "go",
      "description": "Go tools the Dockerfile and compose.yaml run with go run, by their module path",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^compose\\.yaml$/"
      ],
      "matchStrings": [
        "go run (?<depName>[^@\\s]+?)(/cmd/[^@\\s]+)?@(?<currentValue>v\\S+)"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "An update merges itself once the check gate passes, and CI releases one to Go, a module go.mod requires or GoReleaser as a patch of the last release",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    },
    {
      "description": "An Action that cannot run without publishing waits for the maintainer, since no pull request runs it",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/deploy-pages",
        "peter-evans/dockerhub-description"
      ],
      "automerge": false
    },
    {
      "groupName": "GoReleaser",
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ]
    },
    {
      "description": "A GoReleaser major waits for the maintainer: it may rename the release assets, which the gate doesn't check",
      "matchPackageNames": [
        "goreleaser/goreleaser"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "The Dockerfile's LOWEST_GO_VERSION, the lowest supported Go, which only a major raises; a major that raises it raises this match too",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "matchCurrentValue": "/^1\\.22\\./",
      "enabled": false
    }
  ]
}
