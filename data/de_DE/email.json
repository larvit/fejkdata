{
  "format": "{local}@{domain}",
  "local": [
    {
      "format": "{/de_DE.first-name as f}{/de_DE.last-name as l}{slugify(f.name)}{sep}{slugify(l.name)}{n}",
      "weight": 3,
      "sep": [{ "format": ".", "weight": 2 }, "_", "-", ""],
      "n": [{ "format": "", "weight": 3 }, "1", "7", "42", "88", "99"]
    },
    {
      "format": "{adj}{noun}{n}",
      "weight": 2,
      "adj": ["blitz", "cool", "flink", "frech", "froh", "clever", "lustig", "mutig", "schlau", "schnell", "stark", "super", "turbo", "wild"],
      "noun": ["adler", "dachs", "fuchs", "hase", "hund", "igel", "katze", "kolibri", "maus", "ninja", "panda", "pirat", "robbe", "roboter", "uhu", "wolf"],
      "n": [{ "format": "", "weight": 2 }, "7", "13", "14", "42", "77", "99", "123", "420", "2024"]
    },
    {
      "format": "{w}{n}",
      "w": ["blip", "blitzfuchs", "boop", "coolkatze", "fizz", "glorp", "kapow", "kazoo", "nachteule", "pixelfuchs", "plonk", "superhund", "turbohase", "vroom", "wildwolf", "woot", "yeet", "zap", "zoom"],
      "n": [{ "format": "", "weight": 2 }, "7", "14", "42", "69", "99", "123", "420", "1337", "2000", "9000"]
    }
  ],
  "domain": ["demo.example.net", "dev.example.com", "example.com", "example.net", "example.org", "mail.example.com", "mail.example.org", "post.example.com", "test.example.org", "webmail.example.net"],
  "reserved": "{/de_DE.email.local}@{/de_DE.email.domain}"
}
