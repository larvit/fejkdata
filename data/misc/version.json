{
  "format": "{pre}{n}.{n}.{n}{suffix}",
  "let": {
    "n": [{ "format": "{digits(1)}", "weight": 3 }, "{int(10,99)}"],
    "pre": ["", { "format": "v", "weight": 0.4 }],
    "suffix": [
      "",
      { "format": "-{tag}.{m}", "let": { "tag": ["alpha", "beta", "rc"], "m": ["1", "2", "3"] }, "weight": 0.3 }
    ]
  }
}
